# 复制为 .env 后填写。.env 里有密钥，不要提交。

# 对外地址：GitHub 回调地址是 <它>/auth/github/callback
BOARD_PUBLIC_URL=https://board.buglan.com

# GitHub OAuth App（GitHub → Settings → Developer settings → OAuth Apps）
BOARD_GITHUB_CLIENT_ID=
BOARD_GITHUB_CLIENT_SECRET=

# 允许登录的 GitHub 账号（只有这一个账号能登录）
BOARD_GITHUB_USER=

# 动态里的时间按这个时区显示
TZ=Asia/Shanghai

# 日志级别：info / debug / warn
RUST_LOG=info

# 镜像怎么构建：source（在镜像里编译，默认）/ prebuilt（用本机交叉编译好的 deploy/bin/board-server）
BOARD_BUILD=source

# 正在运行的镜像。由自动部署（GitHub Actions，ghcr.io/buglan/board-server:<提交号>）维护，不用手改
BOARD_IMAGE=board-server:latest
