# 复制为 .env 后填写。.env 里有密钥，不要提交。

# 对外地址：GitHub 回调地址是 <它>/auth/github/callback
BOARD_PUBLIC_URL=https://board.example.com

# GitHub OAuth App（GitHub → Settings → Developer settings → OAuth Apps）
BOARD_GITHUB_CLIENT_ID=
BOARD_GITHUB_CLIENT_SECRET=

# 允许登录的 GitHub 账号（只有这一个账号能登录）
BOARD_GITHUB_USER=

# 动态里的时间按这个时区显示
TZ=Asia/Shanghai

# 日志级别：info / debug / warn
RUST_LOG=info

# 镜像怎么构建：source（在镜像里编译，默认）/ prebuilt（用本机交叉编译好的 deploy/bin/board-server）
BOARD_BUILD=source

# Docker 镜像构建时写进 /api/health 的提交号；构建前设为
# BOARD_COMMIT=$(git rev-parse --short=7 HEAD)，不设置时是 unknown
BOARD_COMMIT=

# 可选：备份完成后同步到的异地位置。留空表示只备份到本机 data/backups/
# user@host:/path 用 rsync；/mnt/backup/board 用 cp；rclone:remote:path 用 rclone
BOARD_BACKUP_REMOTE=

# Docker Compose 使用的镜像名。本地构建时保持 `board-server:latest` 即可，用别的镜像时改这里
BOARD_IMAGE=board-server:latest
