{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Board",
  "version": "0.1.25",
  "identifier": "dev.board.desktop",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../web/dist",
    "beforeDevCommand": "node scripts/build-sidecar.mjs --debug && npm run dev:web",
    "beforeBuildCommand": "npm run build:web && node scripts/build-sidecar.mjs"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "看板式白板：人在界面上操作，agent 通过 CLI 操作同一块白板",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/board"],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installerHooks": "./windows/installer-hooks.nsh"
      },
      "wix": {
        "fragmentPaths": ["./windows/path.wxs"],
        "componentRefs": ["BoardCliPathComponent"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/buglan/board/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEzNzE5RUE5MUE5MUZCNEUKUldSTys1RWFxWjV4RXhxdEFDdzdpbVZndWRsemJGZXRZL3NVM0FMQmpJb0JYZXBnd2JHWnJoOSsK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
