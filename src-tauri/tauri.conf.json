{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Board",
  "version": "0.3.0",
  "identifier": "dev.board.desktop",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../web/dist",
    "beforeDevCommand": "node scripts/build-sidecar.mjs --debug && npm run dev:web",
    "beforeBuildCommand": "npm run build:web && node scripts/build-sidecar.mjs"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "看板式白板：人在界面上操作，agent 通过 CLI 操作同一块白板（连接 board.buglan.com）",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/board"],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/installer-hooks.nsh"
      },
      "wix": {
        "fragmentPaths": ["./windows/path.wxs"],
        "componentRefs": ["BoardCliPathComponent"]
      }
    }
  }
}
